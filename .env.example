NODE_ENV=development
STATE_DB_PATH=./data/state.db
LEGACY_STATE_JSON_PATH=./data/state.json
APPROVAL_HISTORY_MAX_RECORDS=2000
APPROVAL_HISTORY_MAX_AGE_DAYS=90
APPROVAL_HISTORY_PRUNE_INTERVAL_MS=300000
APPROVAL_RETENTION_UPDATE_MIN_INTERVAL_MS=2000

# Anthropic Platform Configuration
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_BETA_HEADER=managed-agents-2026-04-01
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5
# Per-role model overrides (optional; falls back to ANTHROPIC_AGENT_MODEL)
ANTHROPIC_DEV_AGENT_MODEL=claude-haiku-4-5
ANTHROPIC_REVIEWER_AGENT_MODEL=claude-haiku-4-5
ANTHROPIC_TESTER_AGENT_MODEL=claude-haiku-4-5

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
GITHUB_REPOSITORY_OWNER=your-org
GITHUB_REPOSITORY_NAME=your-repo
# Public domain for the standalone mcp-vercel-functions deployment.
# The backend resolves this as: https://<domain>/mcp/github/
GITHUB_MCP_DOMAIN=
# Optional explicit override. If set, it takes precedence over GITHUB_MCP_DOMAIN.
GITHUB_MCP_SERVER_URL=

# Documentation / RAG Configuration
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_API_TOKEN=...
VECTOR_STORE_PATH=./data/vector-db

# Frontend URL
CLIENT_URL=http://localhost:5173

# API Base URL
API_PORT=3000
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Managed Agent IDs (auto-logged on first boot; save here to reuse across restarts)
ANTHROPIC_DEV_AGENT_ID=
ANTHROPIC_REVIEWER_AGENT_ID=
ANTHROPIC_TESTER_AGENT_ID=

# Per-role token budgets (0 = unlimited)
TOKEN_BUDGET_DEV=0
TOKEN_BUDGET_REVIEWER=0
TOKEN_BUDGET_TESTER=0
