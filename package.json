{
  "name": "managed-autonomous-engineering-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run backend:dev\" \"npm run frontend:dev\"",
    "jumpstart": "npm run dev",
    "backend:dev": "npm --prefix backend run start:dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "mcp:dev": "npm --prefix mcp-vercel-functions run start:dev",
    "mcp:build": "npm --prefix mcp-vercel-functions run build",
    "mcp:deploy": "npm --prefix mcp-vercel-functions run deploy:vercel",
    "mcp:deploy:prod": "npm --prefix mcp-vercel-functions run deploy:vercel:prod"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
